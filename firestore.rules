rules_version = '2';

// Roami security rules. There are no Cloud Functions, so the app writes to
// Firestore directly and these rules are the server-side enforcement.
// Part 1: profiles, saved places, reports. Trips stay read-only until part 2.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function tripOwnerId(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId;
    }

    function sharedWithMe(tripId) {
      return signedIn()
        && exists(/databases/$(database)/documents/tripShares/$(tripId))
        && request.auth.uid in get(/databases/$(database)/documents/tripShares/$(tripId)).data.viewerIds;
    }

    function canViewTrip(tripId) {
      return isUser(tripOwnerId(tripId)) || sharedWithMe(tripId);
    }

    function taskTripId(stopId) {
      return get(/databases/$(database)/documents/tripStops/$(stopId)).data.tripId;
    }

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    // A change to a stop is allowed only in the same write batch that raises the
    // trip's revision by exactly one. This is how stale edits get refused.
    function revisionBumped(tripId) {
      return getAfter(tripPath(tripId)).data.revision == get(tripPath(tripId)).data.revision + 1;
    }

    function validTrip(tripId, d) {
      return d.keys().hasOnly(['id', 'ownerId', 'city', 'startDate', 'endDate', 'dailyWindow', 'startingPoints', 'candidatePlaceIds', 'revision', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['id', 'ownerId', 'city', 'startDate', 'endDate', 'dailyWindow', 'startingPoints', 'candidatePlaceIds', 'revision', 'createdAt', 'updatedAt'])
        && d.id == tripId
        && shortString(d.city, 100)
        && d.startDate is string && d.startDate.size() == 10
        && d.endDate is string && d.endDate.size() == 10
        && d.dailyWindow is map
        && d.dailyWindow.keys().hasOnly(['start', 'end'])
        && d.dailyWindow.start is string && d.dailyWindow.start.size() == 5
        && d.dailyWindow.end is string && d.dailyWindow.end.size() == 5
        && d.startingPoints is list && d.startingPoints.size() <= 5
        && d.candidatePlaceIds is list && d.candidatePlaceIds.size() <= 50
        && d.revision is int
        && d.createdAt is string && d.updatedAt is string;
    }

    function validStop(stopId, d) {
      return d.keys().hasOnly(['id', 'tripId', 'placeId', 'title', 'recommendationIds', 'day', 'order', 'startTime', 'visitMinutes', 'walkingMinutesFromPrevious', 'isFixed', 'isRequired', 'warnings'])
        && d.keys().hasAll(['id', 'tripId', 'placeId', 'title', 'recommendationIds', 'day', 'order', 'startTime', 'visitMinutes', 'walkingMinutesFromPrevious', 'isFixed', 'isRequired', 'warnings'])
        && d.id == stopId
        && shortString(d.tripId, 200)
        && (d.placeId == null || shortString(d.placeId, 200))
        && (d.title == null || shortString(d.title, 200))
        && (d.placeId != null || d.title != null)
        && d.recommendationIds is list && d.recommendationIds.size() <= 25
        && d.day is int && d.day >= 1 && d.day <= 7
        && d.order is int && d.order >= 1 && d.order <= 5
        && (d.startTime == null || (d.startTime is string && d.startTime.size() == 5))
        && d.visitMinutes is int && d.visitMinutes > 0 && d.visitMinutes <= 720
        && (d.walkingMinutesFromPrevious == null
            || (d.walkingMinutesFromPrevious is number && d.walkingMinutesFromPrevious >= 0))
        && d.isFixed is bool && d.isRequired is bool
        && d.warnings is list && d.warnings.size() <= 20;
    }

    function shortString(v, limit) {
      return v is string && v.size() > 0 && v.size() <= limit;
    }

    function textUpTo(v, limit) {
      return v is string && v.size() <= limit;
    }

    function validProfile(uid, d) {
      return d.keys().hasOnly(['id', 'name', 'bio', 'interests', 'createdAt'])
        && d.id == uid
        && shortString(d.name, 60)
        && textUpTo(d.bio, 500)
        && d.interests is list && d.interests.size() <= 20
        && d.createdAt is string;
    }

    function validSave(saveId, d) {
      return d.keys().hasOnly(['id', 'userId', 'placeId', 'recommendationIds', 'personalNote', 'createdAt'])
        && d.id == saveId
        && saveId == d.userId + '_' + d.placeId
        && shortString(d.placeId, 200)
        && d.recommendationIds is list && d.recommendationIds.size() <= 25
        && textUpTo(d.personalNote, 2000)
        && d.createdAt is string;
    }

    function validReport(reportId, d) {
      return d.keys().hasOnly(['id', 'reporterId', 'contentType', 'contentId', 'reason', 'status', 'reviewedBy', 'createdAt'])
        && d.id == reportId
        && d.reporterId == request.auth.uid
        && d.contentType in ['recommendation', 'comment', 'user']
        && shortString(d.contentId, 200)
        && shortString(d.reason, 500)
        && d.status == 'open'
        && d.reviewedBy == null
        && d.createdAt is string;
    }

    // Profiles: any signed-in user can read; you can create and edit only your own.
    // Profile documents must never hold private data such as email.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isUser(userId) && validProfile(userId, request.resource.data);
      allow update: if isUser(userId)
        && validProfile(userId, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Place catalog: read-only from the app (imported by admin script).
    match /places/{placeId} {
      allow read: if signedIn();
    }

    // Public content: removed or hidden items are visible only to their author.
    match /recommendations/{id} {
      allow read: if signedIn()
        && (resource.data.moderationStatus == 'active' || isUser(resource.data.authorId));
    }

    match /comments/{id} {
      allow read: if signedIn()
        && (resource.data.moderationStatus == 'active' || isUser(resource.data.authorId));
    }

    match /collections/{id} {
      allow read: if signedIn()
        && (resource.data.isPublished == true || isUser(resource.data.ownerId));
    }

    // Saved places: private. The document ID must be userId_placeId, which gives
    // one entry per user and place. The place must exist in the catalog.
    match /savedPlaces/{saveId} {
      allow get: if signedIn() && saveId.split('_')[0] == request.auth.uid;
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isUser(request.resource.data.userId)
        && validSave(saveId, request.resource.data)
        && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId));
      allow update: if isUser(resource.data.userId)
        && validSave(saveId, request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.placeId == resource.data.placeId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isUser(resource.data.userId);
    }

    // Still read-only from the app.
    match /visits/{id} {
      allow read: if isUser(resource.data.userId);
    }

    match /rankings/{id} {
      allow read: if isUser(resource.data.userId);
    }

    match /likes/{id} {
      allow read: if isUser(resource.data.userId);
    }

    match /blocks/{id} {
      allow read: if isUser(resource.data.userId);
    }

    match /follows/{id} {
      allow read: if isUser(resource.data.followerId) || isUser(resource.data.followeeId);
    }

    // Trips: the owner and people the trip is shared with can read (view-only).
    // Only the owner can write, and every change must raise the revision by exactly
    // one, so an out-of-date save is refused. Deleting a trip is not allowed yet.
    match /trips/{tripId} {
      allow read: if isUser(resource.data.ownerId) || sharedWithMe(tripId);
      allow create: if isUser(request.resource.data.ownerId)
        && validTrip(tripId, request.resource.data)
        && request.resource.data.revision == 1;
      allow update: if isUser(resource.data.ownerId)
        && validTrip(tripId, request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
    }

    // Stops can change only in a batch that also raises the trip's revision by one.
    // A stop points to a catalog place, or is a fixed commitment with a title only.
    match /tripStops/{stopId} {
      allow read: if canViewTrip(resource.data.tripId);
      allow create: if isUser(tripOwnerId(request.resource.data.tripId))
        && validStop(stopId, request.resource.data)
        && revisionBumped(request.resource.data.tripId);
      allow update: if isUser(tripOwnerId(resource.data.tripId))
        && validStop(stopId, request.resource.data)
        && request.resource.data.tripId == resource.data.tripId
        && revisionBumped(resource.data.tripId);
      allow delete: if isUser(tripOwnerId(resource.data.tripId))
        && revisionBumped(resource.data.tripId);
    }

    // Sharing: only the trip owner can choose who can view. Viewers can see their own share.
    match /tripShares/{tripId} {
      allow read: if signedIn()
        && (isUser(tripOwnerId(tripId))
            || (resource != null && request.auth.uid in resource.data.viewerIds));
      allow create, update: if isUser(tripOwnerId(tripId))
        && request.resource.data.keys().hasOnly(['tripId', 'viewerIds'])
        && request.resource.data.tripId == tripId
        && request.resource.data.viewerIds is list
        && request.resource.data.viewerIds.size() <= 50;
      allow delete: if isUser(tripOwnerId(tripId));
    }

    // Preparation tasks (booking links, deadlines) are owner-only, even on shared trips.
    match /preparationTasks/{taskId} {
      allow read: if isUser(tripOwnerId(taskTripId(resource.data.tripStopId)));
    }

    // Reports: any signed-in user can file one as themselves, always as 'open'.
    // Nobody can read, change, or delete them from the app. Admins use a script.
    match /reports/{reportId} {
      allow read: if false;
      allow create: if signedIn() && validReport(reportId, request.resource.data);
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}