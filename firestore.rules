rules_version = '2';

// Roami security rules. There are no Cloud Functions, so the app writes to
// Firestore directly and these rules are the server-side enforcement.
// Rules enforce ownership, field shapes, and access to social and travel data.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function tripOwnerId(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId;
    }

    function sharedWithMe(tripId) {
      return signedIn()
        && exists(/databases/$(database)/documents/tripShares/$(tripId))
        && request.auth.uid in get(/databases/$(database)/documents/tripShares/$(tripId)).data.viewerIds;
    }

    function canViewTrip(tripId) {
      return exists(tripPath(tripId)) && (isUser(tripOwnerId(tripId)) || sharedWithMe(tripId));
    }

    function taskTripId(stopId) {
      return get(/databases/$(database)/documents/tripStops/$(stopId)).data.tripId;
    }

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    // A change to a stop is allowed only in the same write batch that raises the
    // trip's revision by exactly one. This is how stale edits get refused.
    function revisionBumped(tripId) {
      return getAfter(tripPath(tripId)).data.revision == get(tripPath(tripId)).data.revision + 1;
    }

    function validStartingPoint(point) {
      return point is map
        && point.keys().hasOnly(['label', 'latitude', 'longitude'])
        && point.keys().hasAll(['label'])
        && shortString(point.label, 100)
        && point.label.matches('.*\\S.*')
        && (!point.keys().hasAny(['latitude', 'longitude'])
          || (point.keys().hasAll(['latitude', 'longitude'])
            && point.latitude is number
            && point.latitude >= -90 && point.latitude <= 90
            && point.longitude is number
            && point.longitude >= -180 && point.longitude <= 180));
    }

    function validStartingPoints(points) {
      return points is list && points.size() <= 5
        && (points.size() < 1 || validStartingPoint(points[0]))
        && (points.size() < 2 || validStartingPoint(points[1]))
        && (points.size() < 3 || validStartingPoint(points[2]))
        && (points.size() < 4 || validStartingPoint(points[3]))
        && (points.size() < 5 || validStartingPoint(points[4]));
    }

    function validWalkingLimit(limit) {
      return limit == null
        || (limit is map
          && limit.keys().hasOnly(['type', 'value'])
          && limit.keys().hasAll(['type', 'value'])
          && limit.type in ['distance', 'duration']
          && limit.value is int
          && limit.value > 0
          && ((limit.type == 'distance' && limit.value <= 100000)
            || (limit.type == 'duration' && limit.value <= 1440)));
    }

    function validTrip(tripId, d) {
      return d.keys().hasOnly(['id', 'ownerId', 'city', 'startDate', 'endDate', 'dailyWindow', 'startingPoints', 'walkingLimit', 'candidatePlaceIds', 'candidateRecommendationIds', 'revision', 'archivedAt', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['id', 'ownerId', 'city', 'startDate', 'endDate', 'dailyWindow', 'candidatePlaceIds', 'revision', 'createdAt', 'updatedAt'])
        && d.id == tripId
        && shortString(d.city, 100)
        && d.startDate is string && d.startDate.size() == 10
        && d.endDate is string && d.endDate.size() == 10
        && d.dailyWindow is map
        && d.dailyWindow.keys().hasOnly(['start', 'end'])
        && d.dailyWindow.start is string && d.dailyWindow.start.size() == 5
        && d.dailyWindow.end is string && d.dailyWindow.end.size() == 5
        && (!d.keys().hasAny(['startingPoints']) || validStartingPoints(d.startingPoints))
        && (!d.keys().hasAny(['walkingLimit']) || validWalkingLimit(d.walkingLimit))
        && d.candidatePlaceIds is list && d.candidatePlaceIds.size() <= 50
        && (!('candidateRecommendationIds' in d) || (d.candidateRecommendationIds is map
          && d.candidateRecommendationIds.keys().hasOnly(d.candidatePlaceIds)))
        && d.revision is int
        && (d.get('archivedAt', null) == null
            || (d.get('archivedAt', null) is string && d.get('archivedAt', '').size() <= 40))
        && d.createdAt is string && d.updatedAt is string;
    }

    function validStop(stopId, d) {
      return d.keys().hasOnly(['id', 'tripId', 'placeId', 'title', 'recommendationIds', 'day', 'order', 'startTime', 'visitMinutes', 'walkingMinutesFromPrevious', 'isFixed', 'isRequired', 'warnings', 'cost'])
        && d.keys().hasAll(['id', 'tripId', 'placeId', 'title', 'recommendationIds', 'day', 'order', 'startTime', 'visitMinutes', 'walkingMinutesFromPrevious', 'isFixed', 'isRequired', 'warnings'])
        && d.id == stopId
        && shortString(d.tripId, 200)
        && (d.placeId == null || shortString(d.placeId, 200))
        && (d.title == null || shortString(d.title, 200))
        && (d.placeId != null || d.title != null)
        && d.recommendationIds is list && d.recommendationIds.size() <= 25
        && d.day is int && d.day >= 1 && d.day <= 7
        && d.order is int && d.order >= 1 && d.order <= 5
        && (d.startTime == null || (d.startTime is string && d.startTime.size() == 5))
        && d.visitMinutes is int && d.visitMinutes > 0 && d.visitMinutes <= 720
        && (d.walkingMinutesFromPrevious == null
            || (d.walkingMinutesFromPrevious is number && d.walkingMinutesFromPrevious >= 0))
        && d.isFixed is bool && d.isRequired is bool
        && d.warnings is list && d.warnings.size() <= 20
        && (!('cost' in d) || d.cost == null || validKnownCost(d.cost));
    }

    function validKnownCost(cost) {
      return cost is map && cost.keys().hasOnly(['amount', 'currency'])
        && cost.amount is number && cost.amount >= 0 && cost.amount <= 1000000000
        && cost.currency is string && cost.currency.matches('^[A-Z]{3}$');
    }

    function shortString(v, limit) {
      return v is string && v.size() > 0 && v.size() <= limit;
    }

    function textUpTo(v, limit) {
      return v is string && v.size() <= limit;
    }

    function validProfile(uid, d) {
      return d.keys().hasOnly(['id', 'name', 'bio', 'interests', 'createdAt'])
        && d.id == uid
        && shortString(d.name, 60)
        && textUpTo(d.bio, 500)
        && d.interests is list && d.interests.size() <= 20
        && d.createdAt is string;
    }

    function validSave(saveId, d) {
      return d.keys().hasOnly(['id', 'userId', 'placeId', 'recommendationIds', 'personalNote', 'createdAt'])
        && d.id == saveId
        && saveId == d.userId + '_' + d.placeId
        && shortString(d.placeId, 200)
        && d.recommendationIds is list && d.recommendationIds.size() <= 25
        && textUpTo(d.personalNote, 2000)
        && d.createdAt is string;
    }

    function validReport(reportId, d) {
      return d.keys().hasOnly(['id', 'reporterId', 'contentType', 'contentId', 'reason', 'status', 'reviewedBy', 'createdAt'])
        && d.id == reportId
        && d.reporterId == request.auth.uid
        && d.contentType in ['recommendation', 'comment', 'user']
        && shortString(d.contentId, 200)
        && shortString(d.reason, 500)
        && d.status == 'open'
        && d.reviewedBy == null
        && d.createdAt is string;
    }

    function validRecommendation(recommendationId, authorId, d) {
      return d.keys().hasOnly(['id', 'authorId', 'placeId', 'description', 'tags', 'visitDate', 'sourceLinks', 'moderationStatus', 'createdAt'])
        && d.keys().hasAll(['id', 'authorId', 'placeId', 'description', 'tags', 'visitDate', 'sourceLinks', 'moderationStatus', 'createdAt'])
        && d.id == recommendationId
        && d.authorId == authorId
        && shortString(d.placeId, 200)
        && d.description is string && d.description.size() > 0
        && d.tags is list
        && (d.visitDate == null || d.visitDate is string)
        && d.sourceLinks is list
        && d.moderationStatus in ['active', 'hidden', 'removed']
        && d.createdAt is string;
    }

    function commentTargetExists(d) {
      return (d.targetType == 'place'
          && exists(/databases/$(database)/documents/places/$(d.targetId)))
        || (d.targetType == 'recommendation'
          && exists(/databases/$(database)/documents/recommendations/$(d.targetId))
          && get(/databases/$(database)/documents/recommendations/$(d.targetId)).data.moderationStatus == 'active');
    }

    function parentCommentIsActive(d) {
      return d.parentCommentId == null
        || (exists(/databases/$(database)/documents/comments/$(d.parentCommentId))
          && get(/databases/$(database)/documents/comments/$(d.parentCommentId)).data.moderationStatus == 'active');
    }

    function validComment(commentId, authorId, d) {
      return d.keys().hasOnly(['id', 'authorId', 'targetType', 'targetId', 'text', 'parentCommentId', 'isQuestion', 'replyPlaceId', 'moderationStatus', 'createdAt'])
        && d.keys().hasAll(['id', 'authorId', 'targetType', 'targetId', 'text', 'parentCommentId', 'isQuestion', 'replyPlaceId', 'moderationStatus', 'createdAt'])
        && d.id == commentId
        && d.authorId == authorId
        && d.targetType in ['recommendation', 'place']
        && shortString(d.targetId, 200)
        && d.text is string && d.text.size() > 0
        && (d.parentCommentId == null || shortString(d.parentCommentId, 200))
        && d.isQuestion is bool
        && (d.replyPlaceId == null || shortString(d.replyPlaceId, 200))
        && d.moderationStatus in ['active', 'hidden', 'removed']
        && d.createdAt is string;
    }

    function validLike(d) {
      return d.keys().hasOnly(['userId', 'recommendationId', 'createdAt'])
        && d.keys().hasAll(['userId', 'recommendationId', 'createdAt'])
        && d.userId == request.auth.uid
        && shortString(d.recommendationId, 200)
        && d.createdAt is string;
    }

    function validFollow(d) {
      return d.keys().hasOnly(['followerId', 'followeeId', 'createdAt'])
        && d.keys().hasAll(['followerId', 'followeeId', 'createdAt'])
        && d.followerId == request.auth.uid
        && shortString(d.followeeId, 200)
        && d.followeeId != d.followerId
        && d.createdAt is string;
    }

    function validCollection(collectionId, ownerId, d) {
      return d.keys().hasOnly(['id', 'ownerId', 'title', 'placeIds', 'recommendationIds', 'isPublished', 'createdAt'])
        && d.keys().hasAll(['id', 'ownerId', 'title', 'placeIds', 'recommendationIds', 'isPublished', 'createdAt'])
        && d.id == collectionId
        && d.ownerId == ownerId
        && d.title is string && d.title.size() > 0
        && d.placeIds is list
        && d.recommendationIds is list
        && d.isPublished is bool
        && d.createdAt is string;
    }

    function validVisit(visitId, userId, d) {
      return d.keys().hasOnly(['id', 'userId', 'placeId', 'visitDate'])
        && d.keys().hasAll(['id', 'userId', 'placeId', 'visitDate'])
        && d.id == visitId
        && d.userId == userId
        && shortString(d.placeId, 200)
        && shortString(d.visitDate, 10);
    }

    function validRanking(rankingId, userId, d) {
      return d.keys().hasOnly(['id', 'userId', 'category', 'placeIds'])
        && d.keys().hasAll(['id', 'userId', 'category', 'placeIds'])
        && d.id == rankingId
        && d.userId == userId
        && d.category is string && d.category.size() > 0
        && rankingId == userId + '_' + d.category
        && d.placeIds is list;
    }

    function validBlock(d) {
      return d.keys().hasOnly(['userId', 'blockedUserId', 'createdAt'])
        && d.keys().hasAll(['userId', 'blockedUserId', 'createdAt'])
        && d.userId == request.auth.uid
        && shortString(d.blockedUserId, 200)
        && d.blockedUserId != d.userId
        && d.createdAt is string;
    }

    function validPreparationTask(taskId, d) {
      return d.keys().hasOnly(['id', 'tripStopId', 'title', 'bookingUrl', 'source', 'deadline', 'needsReview', 'completed', 'reviewedSchedule'])
        && d.keys().hasAll(['id', 'tripStopId', 'title', 'bookingUrl', 'source', 'deadline', 'needsReview'])
        && d.id == taskId
        && shortString(d.tripStopId, 200)
        && d.title is string && d.title.size() > 0
        && (d.bookingUrl == null || d.bookingUrl is string)
        && (d.source == null || d.source is string)
        && (d.deadline == null || d.deadline is string)
        && d.needsReview is bool
        && (!('completed' in d) || d.completed is bool)
        && (!('reviewedSchedule' in d) || validReviewedSchedule(d.reviewedSchedule))
        && exists(/databases/$(database)/documents/tripStops/$(d.tripStopId));
    }

    function validReviewedSchedule(schedule) {
      return schedule is map && schedule.keys().hasOnly(['day', 'startTime', 'visitMinutes'])
        && schedule.day is int && schedule.day >= 1 && schedule.day <= 7
        && (schedule.startTime == null || schedule.startTime is string)
        && schedule.visitMinutes is int && schedule.visitMinutes > 0 && schedule.visitMinutes <= 720;
    }

    // Profiles: any signed-in user can read; you can create and edit only your own.
    // Profile documents must never hold private data such as email.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isUser(userId) && validProfile(userId, request.resource.data);
      allow update: if isUser(userId)
        && validProfile(userId, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // ---------- Places imported from OpenStreetMap ----------
    // Keep in step with mobile/src/logic/osmPlaces.ts: REFRESH_DAYS (30),
    // MAX_NAME_LENGTH, MAX_HOURS_LENGTH and OSM_CATEGORIES.
    // The rules can check a place's shape but not that it really came from
    // OSM, so a signed-in user could add a made-up place. Nobody can delete
    // places or change hand-made ones.

    function refreshDue(d) {
      return request.time > d.importedAt + duration.value(30, 'd');
    }

    function validOsmPlace(placeId, d) {
      return d.keys().hasOnly(['id', 'name', 'city', 'cityId', 'latitude', 'longitude', 'category', 'openingHours', 'missingFields', 'source', 'updatedAt', 'importedAt'])
        && d.keys().hasAll(['id', 'name', 'city', 'cityId', 'latitude', 'longitude', 'category', 'openingHours', 'missingFields', 'source', 'updatedAt', 'importedAt'])
        && d.id == placeId
        && placeId.matches('osm-(node|way|relation)-[1-9][0-9]{0,15}')
        && d.source is map
        && d.source.keys().hasOnly(['provider', 'providerId', 'retrievedAt'])
        && d.source.keys().hasAll(['provider', 'providerId', 'retrievedAt'])
        && d.source.provider == 'osm'
        && d.source.providerId is string
        && placeId == 'osm-' + d.source.providerId.replace('/', '-')
        && shortString(d.source.retrievedAt, 40)
        && shortString(d.name, 200)
        && shortString(d.city, 100)
        && d.cityId is string && d.cityId.matches('osm-relation-[1-9][0-9]{0,11}')
        && d.latitude is number && d.latitude >= -90 && d.latitude <= 90
        && d.longitude is number && d.longitude >= -180 && d.longitude <= 180
        && d.category in ['museum', 'gallery', 'attraction', 'viewpoint', 'zoo', 'aquarium', 'theme park', 'landmark', 'theater', 'arts center', 'cinema', 'market', 'library', 'music venue', 'park', 'garden', 'beach', 'cafe', 'restaurant', 'bar', 'dessert shop', 'bookstore', 'bakery', 'chocolate shop', 'tea shop']
        && (d.openingHours == null || shortString(d.openingHours, 300))
        && d.missingFields is list && d.missingFields.hasOnly(['openingHours'])
        && shortString(d.updatedAt, 40)
        && d.importedAt == request.time;
    }

    function validCityImport(cityId, d) {
      return d.keys().hasOnly(['cityId', 'name', 'placeCount', 'importedAt'])
        && d.keys().hasAll(['cityId', 'name', 'placeCount', 'importedAt'])
        && d.cityId == cityId
        && cityId.matches('osm-relation-[1-9][0-9]{0,11}')
        && shortString(d.name, 100)
        && d.placeCount is int && d.placeCount >= 0 && d.placeCount <= 400
        && d.importedAt == request.time;
    }

    // Place catalog. Hand-made places come from the admin seed script and
    // can't be changed from the app. Any signed-in user can add a place from
    // OpenStreetMap, and rewrite one only once it is due for a refresh, without
    // moving it to another city.
    match /places/{placeId} {
      allow read: if signedIn();
      allow create: if signedIn() && validOsmPlace(placeId, request.resource.data);
      allow update: if signedIn()
        && resource.data.source.provider == 'osm'
        && refreshDue(resource.data)
        && validOsmPlace(placeId, request.resource.data)
        && request.resource.data.cityId == resource.data.cityId;
    }

    // One record per imported city, written after its places. Rewritten only
    // when the city is due for a refresh.
    match /cityImports/{cityId} {
      allow read: if signedIn();
      allow create: if signedIn() && validCityImport(cityId, request.resource.data);
      allow update: if signedIn()
        && refreshDue(resource.data)
        && validCityImport(cityId, request.resource.data);
    }

    // Public content: removed or hidden items are visible only to their author.
    match /recommendations/{id} {
      allow read: if signedIn()
        && (resource.data.moderationStatus == 'active' || isUser(resource.data.authorId));
      allow create: if signedIn()
        && validRecommendation(id, request.auth.uid, request.resource.data)
        && request.resource.data.moderationStatus == 'active'
        && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId));
      allow update: if isUser(resource.data.authorId)
        && validRecommendation(id, resource.data.authorId, request.resource.data)
        && request.resource.data.placeId == resource.data.placeId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.moderationStatus == resource.data.moderationStatus;
      allow delete: if isUser(resource.data.authorId);
    }

    match /comments/{id} {
      allow read: if signedIn()
        && (resource.data.moderationStatus == 'active' || isUser(resource.data.authorId));
      allow create: if signedIn()
        && validComment(id, request.auth.uid, request.resource.data)
        && request.resource.data.moderationStatus == 'active'
        && commentTargetExists(request.resource.data)
        && parentCommentIsActive(request.resource.data)
        && (request.resource.data.replyPlaceId == null
          || exists(/databases/$(database)/documents/places/$(request.resource.data.replyPlaceId)));
      allow update: if isUser(resource.data.authorId)
        && validComment(id, resource.data.authorId, request.resource.data)
        && request.resource.data.targetType == resource.data.targetType
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.parentCommentId == resource.data.parentCommentId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.moderationStatus == resource.data.moderationStatus
        && commentTargetExists(request.resource.data)
        && parentCommentIsActive(request.resource.data)
        && (request.resource.data.replyPlaceId == null
          || exists(/databases/$(database)/documents/places/$(request.resource.data.replyPlaceId)));
      allow delete: if isUser(resource.data.authorId);
    }

    match /collections/{id} {
      allow read: if signedIn()
        && (resource.data.isPublished == true || isUser(resource.data.ownerId));
      allow create: if isUser(request.resource.data.ownerId)
        && validCollection(id, request.auth.uid, request.resource.data);
      allow update: if isUser(resource.data.ownerId)
        && validCollection(id, resource.data.ownerId, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isUser(resource.data.ownerId);
    }

    // Saved places: private. The document ID must be userId_placeId, which gives
    // one entry per user and place. The place must exist in the catalog.
    match /savedPlaces/{saveId} {
      allow get: if signedIn() && (
        resource == null
          ? saveId.split('_')[0] == request.auth.uid
          : resource.data.userId == request.auth.uid
      );
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isUser(request.resource.data.userId)
        && validSave(saveId, request.resource.data)
        && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId));
      allow update: if isUser(resource.data.userId)
        && validSave(saveId, request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.placeId == resource.data.placeId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isUser(resource.data.userId);
    }

    match /visits/{id} {
      allow read: if isUser(resource.data.userId);
      allow create: if isUser(request.resource.data.userId)
        && validVisit(id, request.auth.uid, request.resource.data)
        && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId));
      allow update: if isUser(resource.data.userId)
        && validVisit(id, resource.data.userId, request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId));
      allow delete: if isUser(resource.data.userId);
    }

    match /rankings/{id} {
      allow read: if isUser(resource.data.userId);
      allow create: if isUser(request.resource.data.userId)
        && validRanking(id, request.auth.uid, request.resource.data);
      allow update: if isUser(resource.data.userId)
        && validRanking(id, resource.data.userId, request.resource.data);
      allow delete: if isUser(resource.data.userId);
    }

    match /likes/{id} {
      allow read: if isUser(resource.data.userId);
      allow create: if signedIn()
        && validLike(request.resource.data)
        && exists(/databases/$(database)/documents/recommendations/$(request.resource.data.recommendationId))
        && get(/databases/$(database)/documents/recommendations/$(request.resource.data.recommendationId)).data.moderationStatus == 'active';
      allow delete: if isUser(resource.data.userId);
    }

    match /blocks/{id} {
      allow read: if isUser(resource.data.userId);
      allow create: if signedIn()
        && validBlock(request.resource.data)
        && exists(/databases/$(database)/documents/users/$(request.resource.data.blockedUserId));
      allow delete: if isUser(resource.data.userId);
    }

    match /follows/{id} {
      allow read: if isUser(resource.data.followerId) || isUser(resource.data.followeeId);
      allow create: if signedIn()
        && validFollow(request.resource.data)
        && exists(/databases/$(database)/documents/users/$(request.resource.data.followeeId));
      allow delete: if isUser(resource.data.followerId);
    }

    // Trips: the owner and people the trip is shared with can read (view-only).
    // Only the owner can delete a trip or update its current revision.
    match /trips/{tripId} {
      allow read: if isUser(resource.data.ownerId) || sharedWithMe(tripId);
      allow create: if isUser(request.resource.data.ownerId)
        && validTrip(tripId, request.resource.data)
        && request.resource.data.revision == 1;
      allow update: if isUser(resource.data.ownerId)
        && validTrip(tripId, request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if isUser(resource.data.ownerId);
    }

    // Stops change with a trip revision bump, or are removed with the trip.
    // A stop points to a catalog place, or is a fixed commitment with a title only.
    match /tripStops/{stopId} {
      allow read: if canViewTrip(resource.data.tripId);
      allow create: if isUser(tripOwnerId(request.resource.data.tripId))
        && validStop(stopId, request.resource.data)
        && revisionBumped(request.resource.data.tripId);
      allow update: if isUser(tripOwnerId(resource.data.tripId))
        && validStop(stopId, request.resource.data)
        && request.resource.data.tripId == resource.data.tripId
        && revisionBumped(resource.data.tripId);
      allow delete: if isUser(tripOwnerId(resource.data.tripId))
        && (!existsAfter(tripPath(resource.data.tripId)) || revisionBumped(resource.data.tripId));
    }

    // Sharing: only the trip owner can choose who can view. Viewers can see their own share.
    match /tripShares/{tripId} {
      allow read: if signedIn() && exists(tripPath(tripId))
        && (isUser(tripOwnerId(tripId))
            || (resource != null && request.auth.uid in resource.data.viewerIds));
      allow create, update: if isUser(tripOwnerId(tripId))
        && request.resource.data.keys().hasOnly(['tripId', 'viewerIds'])
        && request.resource.data.tripId == tripId
        && request.resource.data.viewerIds is list
        && request.resource.data.viewerIds.size() <= 50;
      allow delete: if isUser(tripOwnerId(tripId));
    }

    // Preparation tasks (booking links, deadlines) are owner-only, even on shared trips.
    match /preparationTasks/{taskId} {
      allow read: if isUser(tripOwnerId(taskTripId(resource.data.tripStopId)));
      allow create: if validPreparationTask(taskId, request.resource.data)
        && isUser(tripOwnerId(taskTripId(request.resource.data.tripStopId)));
      allow update: if validPreparationTask(taskId, request.resource.data)
        && isUser(tripOwnerId(taskTripId(resource.data.tripStopId)))
        && request.resource.data.tripStopId == resource.data.tripStopId;
      allow delete: if isUser(tripOwnerId(taskTripId(resource.data.tripStopId)));
    }

    // Reports: any signed-in user can file one as themselves, always as 'open'.
    // Nobody can read, change, or delete them from the app. Admins use a script.
    match /reports/{reportId} {
      allow read: if false;
      allow create: if signedIn() && validReport(reportId, request.resource.data);
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
