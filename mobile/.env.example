# Copy to .env and fill in. Ask the team lead for the Firebase values.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional. Your laptop's address, to sign in against the local Auth emulator
# (find it with: ipconfig getifaddr en0). Leave empty to use real Firebase.
EXPO_PUBLIC_EMULATOR_HOST=

# Optional. "live" once real services are registered; empty uses fixture data.
EXPO_PUBLIC_API_MODE=

# Optional. Skip sign-in and use sample data without Firebase or its emulators.
EXPO_PUBLIC_FRONTEND_PREVIEW=false
